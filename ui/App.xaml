<Application x:Class="Screenlet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#00796B</Color>
                    <Color x:Key="SystemAccentColorDark1">#00695C</Color>
                    <Color x:Key="SystemAccentColorDark2">#005B4F</Color>
                    <Color x:Key="SystemAccentColorLight1">#0B8F80</Color>
                    <Color x:Key="SystemAccentColorLight2">#2BA696</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#2BA696</Color>
                    <Color x:Key="SystemAccentColorLight1">#46B8A9</Color>
                    <Color x:Key="SystemAccentColorLight2">#6CCABD</Color>
                    <Color x:Key="SystemAccentColorLight3">#94DBD1</Color>
                    <Color x:Key="SystemAccentColorDark1">#0B8F80</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="HelpButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Content" Value="&#xE897;"/>
            </Style>
            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,18,0,8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
